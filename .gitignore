# ── 설정 / 시크릿 ─────────────────────────────
*.yml
*.yaml
!docker-compose.yml
!docker-compose.*.yml

# .github 은 설정 전용이며 시크릿을 담지 않는다. CI·이슈 템플릿·PR 설정이 여기 있다.
!.github/**/*.yml

*.properties
!gradle.properties
# 없으면 clone 후 ./gradlew 가 동작하지 않는다. 시크릿이 아니라 빌드 메타데이터다.
!gradle/wrapper/gradle-wrapper.properties

.env
.env.*
!.env.example

# 공개 레포에 올리지 않는 내부 문서 (S-11, §13-12). 별도 비공개 백업으로 관리한다.
docs/internal/

# ── 키 / 인증서 ──────────────────────────────
*.pem
*.p8
*.p12
*.jks
*.keystore
*-key.json
secrets/

# ── 빌드 산출물 ──────────────────────────────
build/
out/
bin/
.gradle/
*.log

# ── IDE ──────────────────────────────────────
.idea/
*.iml
.vscode/
