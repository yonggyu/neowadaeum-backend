# ─────────────────────────────────────────────────────────────
# 앞단 리버스 프록시 (이슈 #448)
#
# 근거와 그림은 `docs/deployment.md` §5. 여기에는 **왜 이 모양인가**만 짧게 적는다.
#
# - **단일 오리진이다.** `/api/*` 만 백엔드로 가고 나머지는 전부 프론트로 간다.
#   서브도메인으로 가르면 CSRF 쿠키에 `Domain` 이 필요해지는데 코드에 그 속성이 없다
#   (ADR-0008). 그 배치는 부팅에 성공한 뒤 남의 브라우저에서 실패한다.
# - **blue ⇄ green 전환점은 이 파일이 아니라 `upstream.caddy` 한 줄이다.**
#   전환은 그 줄을 고치고 `caddy reload` 하는 것이 전부다 — 컨테이너를 다시 만들지 않으므로
#   열린 연결도 발급받은 인증서도 그대로 남는다.
# - **실제 도메인·메일 주소를 여기에 적지 않는다** (S-11). 값은 배포 환경변수로 온다.
#
# 문법 확인:
#   docker run --rm -e PUBLIC_DOMAIN=example.com -e ACME_EMAIL=ops@example.com \
#     -v "$PWD/docker/caddy:/etc/caddy:ro" caddy:2.10-alpine \
#     caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
# ─────────────────────────────────────────────────────────────
{
	# ACME 계정 메일. **기본값을 두지 않는다** (§7.3) — 값이 없으면 여기서 뜨지 않는다.
	email {$ACME_EMAIL}

	# 관리 API 는 컨테이너 안 루프백에만 연다. `caddy reload` 가 이것을 쓴다.
	admin localhost:2019

	# ── 전달 헤더는 여기서 잘린다 (§13-45) ──────────────────
	# `trusted_proxies` 를 **설정하지 않는다.** 기본값이 "아무도 신뢰하지 않음"이고,
	# 신뢰하지 않는 peer 가 보낸 `X-Forwarded-*` 는 **이어 붙이지 않고 버린 뒤 새로 쓴다.**
	# 그래서 앱이 보는 `X-Forwarded-For` 는 언제나 실제 접속자 하나다 — 헤더 한 줄로
	# IP 한도(S-8)나 관리자 IP 제한(S-4)을 우회할 수 없다. (로컬에서 위조 헤더로 확인했다.)
	#
	# **이 앞에 CDN 이나 L7 로드밸런서를 둔다면 그때 `trusted_proxies` 를 설정해야 한다.**
	# 그러지 않으면 반대로 모든 접속자가 그 장비 하나로 보인다.
}

# 사이트 주소가 **도메인**이어야 자동 HTTPS(ACME)가 성립한다. 값이 없으면 설정이 서지 않는다.
# 이 순서가 곧 호스트 준비 순서다 — 도메인 → DNS → 이 값 → 인증서.
{$PUBLIC_DOMAIN} {
	encode zstd gzip

	# ── 프로브는 밖으로 내지 않는다 ──────────────────────────
	# `/actuator/**` 는 프록시가 내부망에서 보는 것이지 인터넷이 볼 것이 아니다.
	# 프론트로 흘리면 SPA 가 200 으로 앱 껍데기를 돌려주어 "열려 있는지"가 흐려진다.
	handle /actuator/* {
		abort
	}

	# ── /api → 백엔드 (blue 또는 green) ─────────────────────
	handle /api/* {
		import /etc/caddy/upstream.caddy
	}

	# ── 그 밖의 전부 → 프론트 ───────────────────────────────
	# 프론트 이미지에는 헬스체크가 없다. 그래서 프로브 대신 재시도 창을 둔다 —
	# 이미지를 갈아 끼우는 1~2초 동안 요청이 502 로 떨어지지 않고 기다린다.
	handle {
		reverse_proxy web:8080 {
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}

	log {
		output stderr
		format json
	}
}
