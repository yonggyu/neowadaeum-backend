# ─────────────────────────────────────────────────────────────
# **blue ⇄ green 전환점.** 이 파일이 지금 트래픽을 받는 쪽을 가리킨다.
#
# 전환:
#   1) 아래 `reverse_proxy` 의 대상을 `app-blue:8080` ⇄ `app-green:8080` 으로 바꾼다
#   2) docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
#
# 되돌리기는 같은 두 줄을 반대로 하는 것이다 (`docs/deployment.md` §4 · §5).
# **파일 하나·줄 하나인 것이 요점이다** — 장애 중에 고치는 것은 짧아야 한다.
#
# `caddy reload` 는 무중단이다. 컨테이너를 다시 만들지 않으므로 `/data` 의 인증서도
# 그대로 남는다. 반대로 이 값을 환경변수로 두면 전환할 때마다 컨테이너를 다시 만들어야 하고,
# 그것은 전환이 아니라 재시작이다.
# ─────────────────────────────────────────────────────────────

reverse_proxy app-blue:8080 {
	# **준비되지 않은 쪽으로 보내지 않는다.** B-48 이 켠 readiness 프로브를 프록시가 본다
	# (`docs/deployment.md` §3). 이 프로브는 내부망에서만 불린다 — 밖으로는 내지 않는다.
	health_uri /actuator/health/readiness
	health_interval 5s
	health_timeout 2s

	# 전환 직후 몇 백 밀리초를 흡수한다. 이것이 없으면 전환 자체가 502 를 만든다.
	lb_try_duration 10s
	lb_try_interval 250ms
}
