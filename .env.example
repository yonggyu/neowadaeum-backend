# ─────────────────────────────────────────────────────────────
# 값은 비워 둔다. 형식만 보여준다. (§7.4)
# 실제 값은 .env에 채운다. .env는 커밋되지 않는다.
# ─────────────────────────────────────────────────────────────

# ── docker-compose.yml 이 읽는 값 (§2.5) ─────────────────────
# ※ POSTGRES_PORT 와 아래 *_DB_URL 의 포트는 반드시 같은 값이어야 한다.
#    어긋나면 조용히 다른 DB에 붙는다. 바꿀 때는 항상 함께 바꾼다.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── 4-스토어 접속 정보 (§5.3) ────────────────────────────────
# URL 예시: jdbc:postgresql://localhost:5432/<POSTGRES_DB>?currentSchema=identity
IDENTITY_DB_URL=
IDENTITY_DB_USER=
IDENTITY_DB_PASSWORD=
CATALOG_DB_URL=
CATALOG_DB_USER=
CATALOG_DB_PASSWORD=
PLAY_DB_URL=
PLAY_DB_USER=
PLAY_DB_PASSWORD=
PROMPTLOG_DB_URL=
PROMPTLOG_DB_USER=
PROMPTLOG_DB_PASSWORD=

# ── 캐시 / 락 ────────────────────────────────────────────────
REDIS_URL=

# ── 인증 ─────────────────────────────────────────────────────
JWT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── AI Provider ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=

# ── 관리자 ───────────────────────────────────────────────────
ADMIN_ALLOWED_CIDR=
