# ─────────────────────────────────────────────────────────────
# 값은 비워 둔다. 형식만 보여준다. (§7.4)
# 실제 값은 .env에 채운다. .env는 커밋되지 않는다.
#
# ── 필수 / 선택 표시 (#489) ──────────────────────────────────
# 각 구획 앞에 `# [required]` 또는 `# [optional]` 한 줄이 있고, 그 표시는 **다음 표시가
# 나올 때까지의 모든 키**에 적용된다. `scripts/check-env-drift.sh` 가 이 표시를 읽어
# 로컬 `.env` 와 대조한다 — **필수 키가 없으면 실패하고, 선택 키가 없으면 알리기만 한다.**
#
#   [required] — 이 키가 없으면 앱이 뜨지 않는다. 부팅 중에 값이 검증되거나(§7.3 — 기본값을
#                두지 않으므로), 로컬 인프라 컨테이너가 그 값으로 떠야 하는 자리다.
#   [optional] — 그 기능을 켤 때 채운다. 하나도 없으면 부팅은 되고 그 경로만 죽는다.
#                새로 온 사람이 값을 구하지 못해 시작조차 못 하는 일을 막는 자리다.
#
# ★ **표시를 붙이지 않은 키는 필수로 읽힌다.** 잊고 더한 키가 조용히 선택이 되는 것보다,
#   시끄럽게 필수가 되어 표시를 붙이게 만드는 쪽이 낫다. 키를 더할 때 이 판단을 함께 한다.
# ★ 대조는 **키 이름으로만** 한다. 이 파일에도 스크립트 출력에도 값은 나오지 않는다 (S-11).
# ─────────────────────────────────────────────────────────────

# ── docker-compose.yml 이 읽는 값 (§2.5) ─────────────────────
# [required] 로컬 DB·Redis 컨테이너가 이 값으로 뜬다. 비면 컨테이너가 서고 앱도 붙지 못한다.
# ※ POSTGRES_PORT 와 아래 *_DB_URL 의 포트는 반드시 같은 값이어야 한다.
#    어긋나면 조용히 다른 DB에 붙는다. 바꿀 때는 항상 함께 바꾼다.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── 4-스토어 접속 정보 (§5.3) ────────────────────────────────
# [required] DataSource 4벌이 이 값으로 만들어진다. 하나만 빠져도 그 스토어에서 부팅이 선다.
# URL 예시: jdbc:postgresql://localhost:5432/<POSTGRES_DB>?currentSchema=identity
IDENTITY_DB_URL=
IDENTITY_DB_USER=
IDENTITY_DB_PASSWORD=
CATALOG_DB_URL=
CATALOG_DB_USER=
CATALOG_DB_PASSWORD=
PLAY_DB_URL=
PLAY_DB_USER=
PLAY_DB_PASSWORD=
PROMPTLOG_DB_URL=
PROMPTLOG_DB_USER=
PROMPTLOG_DB_PASSWORD=

# ── 캐시 / 락 ────────────────────────────────────────────────
# [required] spring.data.redis.url 이 이 값 하나다.
REDIS_URL=

# ── 인증 ─────────────────────────────────────────────────────
# [required] 넷 다 부팅 중에 검증된다 — 형식이 맞지 않으면 그 자리에서 컨텍스트가 선다.
#            (JWT 키 길이 · 오리진 형식 · Secure 플래그 · 구글 aud 검증용 client-id)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# 리프레시 쿠키의 Secure 속성 (ADR-0008). 로컬은 HTTP 이므로 false, 배포는 반드시 true.
REFRESH_COOKIE_SECURE=false
JWT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
# [optional] 로그인은 ID 토큰을 검증하는 방식이라 client-secret 을 쓰는 자리가 아직 없다.
#            서버가 authorization code 를 직접 교환하게 되는 날 필수가 된다.
GOOGLE_OAUTH_CLIENT_SECRET=

# ── AI Provider ──────────────────────────────────────────────
# [optional] 어댑터는 **키와 모델이 둘 다 있을 때만** 등록된다 — 키만 채워도 아무것도 켜지지
#            않고, 비워 두면 등록되지 않을 뿐 부팅은 된다. 실제 Provider 를 붙이는 날
#            application.yml 의 models.* 와 함께 채운다. openai 는 어댑터 자체가 아직 없다.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=

# ── 관리자 ───────────────────────────────────────────────────
# [required] 둘 다 부팅 중에 검증된다 (S-4). CIDR 은 파싱되고, TOTP 키는 base64 32바이트여야
#            한다 — 비어 있음을 "제한 없음"으로 읽지 않는 쪽이 이 설계의 요점이다.
ADMIN_ALLOWED_CIDR=

# 관리자 TOTP 비밀을 감싸는 키. base64 로 적은 32바이트다.
#   openssl rand -base64 32
ADMIN_TOTP_SECRET_KEY=

# ── 원고 이미지 저장소 (#315, §13-65) ─────────────────────────
# [optional] 다섯이 전부-또는-전무다. 하나도 없으면 부팅은 되고 이미지 업로드 경로만 죽는다 —
#            로컬·CI 는 객체 저장소를 갖지 않으므로 이것이 기본 상태다. 다만 **하나만 빠지면
#            부팅이 멈춘다**: 절반만 설정된 것은 "쓰지 않는다"가 아니라 설정하다 만 것이다.
#            그래서 이 다섯의 짝은 스크립트가 아니라 ImageStorageProperties 가 본다.
# S3 호환 객체 저장소. 브라우저가 presigned URL 로 직접 올린다.
#
# ★ 버킷은 **비공개여야 한다.** 공개 읽기가 열려 있으면 키를 아는 사람이 검수 전 이미지를
#   볼 수 있고, 그것은 코드가 막을 수 없는 자리다 (I-8).
IMAGE_STORAGE_ENDPOINT=
IMAGE_STORAGE_REGION=
IMAGE_STORAGE_BUCKET=
IMAGE_STORAGE_ACCESS_KEY=
IMAGE_STORAGE_SECRET_KEY=
