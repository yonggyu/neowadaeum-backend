# ─────────────────────────────────────────────────────────────
# application.yml.template  (§7.3)
#
#   cp src/main/resources/application.yml.template \
#      src/main/resources/application.yml
#
# ※ application.yml 은 .gitignore 의 `*.yml` 에 걸려 추적되지 않는다 (§7.2).
# ※ 플레이스홀더만 둔다. `${VAR:실제값}` 기본값 패턴은 금지다 (§7.1-3, §7.3).
#    값이 없으면 부팅이 실패해야 한다. 조용히 잘못된 값으로 뜨는 것보다 낫다.
# ─────────────────────────────────────────────────────────────
spring:
  application:
    name: neowadaeum-backend

  # ── 자동설정 제외 (§2.2, §5.3) ─────────────────────────────
  # B-05 이전의 한시적 DataSourceAutoConfiguration 제외는 제거했다.
  # 이제 DataSource 빈이 4개 존재하므로 그 자동설정은 스스로 물러난다.
  #
  # 아래 셋은 영구 제외다. 이 프로젝트는 스토어별로 직접 배선한다.
  #   - JPA 2종 — 자동설정은 EntityManagerFactory 를 1벌만 만든다. 한 EMF 에 네 스키마의
  #     엔티티가 묶이면 JPQL 한 줄로 크로스 스키마 조인이 가능해져 §5.3 이 무너진다.
  #     FK 검증(§5.3 테스트)은 FK 만 보므로 이 경로를 잡지 못한다.
  #     스토어별 EMF / TransactionManager 4벌은 B-05-1 에서 명시 구성한다.
  #   - Flyway — 자동설정은 인스턴스를 1개만 만든다. 스토어별 4세트는 config 에서 직접 만든다.
  #
  # ★ §2.2 — 존재하지 않는 FQCN 을 여기 써도 Spring 은 오류 없이 무시한다.
  #   Boot 4 에서 자동설정 패키지가 전부 이동했으므로 낡은 이름을 적어도 조용히 통과한다.
  #   따라서 "파일에 적혀 있다"는 것은 아무것도 보장하지 않는다.
  #   AutoConfigurationExclusionTests 가 세 이름이 실제 자동설정 클래스이고,
  #   해당 빈이 컨텍스트에 없다는 것을 동작으로 검증한다.
  #
  #   조사 결과(B-05) — 여기 있던 org.springframework.boot.jdbc.autoconfigure.DataSourceAutoConfiguration
  #   은 Boot 4.1 에서도 유효한 이름이었다. 즉 B-02~B-04 구간의 제외는 실제로 동작하고 있었다.
  #   이 경고는 사후 확인 결과이지 이 프로젝트에서 발생한 사고의 기록이 아니다.
  #   같은 확인을 반복하지 않도록 남긴다.
  autoconfigure:
    exclude:
      - org.springframework.boot.hibernate.autoconfigure.HibernateJpaAutoConfiguration
      - org.springframework.boot.data.jpa.autoconfigure.DataJpaRepositoriesAutoConfiguration
      - org.springframework.boot.flyway.autoconfigure.FlywayAutoConfiguration

  # ── 로컬 인프라 자동 기동 (§2.5) ───────────────────────────
  # 커넥션 정보는 자동 주입되지 않는다. 컨테이너 수명 관리 용도로만 쓴다.
  docker:
    compose:
      enabled: true
      file: docker-compose.yml
      lifecycle-management: start-only   # 앱을 꺼도 DB는 살려 둔다
      skip:
        in-tests: true                   # 테스트는 Testcontainers를 쓴다 (§10)

  data:
    redis:
      url: ${REDIS_URL}

  jackson:
    property-naming-strategy: LOWER_CAMEL_CASE   # API JSON은 camelCase (§9.1)

# ── 4-스토어 DataSource (§5.3, §2.5) ─────────────────────────
# DataSourceConfiguration 이 이 프로퍼티만 읽어 DataSource 빈 4개를 만든다.
# 스키마 간 FK / JOIN 금지. 각 계정은 자기 스키마에만 권한을 갖는다.
# URL 에 `?currentSchema=<스키마>` 가 없으면 부팅이 실패한다 — 빠지면 조용히 다른 스키마에 쓴다.
app:
  datasource:
    identity:
      url: ${IDENTITY_DB_URL}       # jdbc:postgresql://localhost:5432/neowadaeum?currentSchema=identity
      username: ${IDENTITY_DB_USER}
      password: ${IDENTITY_DB_PASSWORD}
    catalog:
      url: ${CATALOG_DB_URL}
      username: ${CATALOG_DB_USER}
      password: ${CATALOG_DB_PASSWORD}
    play:
      url: ${PLAY_DB_URL}
      username: ${PLAY_DB_USER}
      password: ${PLAY_DB_PASSWORD}
    promptlog:
      url: ${PROMPTLOG_DB_URL}
      username: ${PROMPTLOG_DB_USER}
      password: ${PROMPTLOG_DB_PASSWORD}

# ── 인증 (§12 B-12) ──────────────────────────────────────────
auth:
  jwt:
    secret: ${JWT_SECRET}

security:
  oauth2:
    google:
      client-id: ${GOOGLE_OAUTH_CLIENT_ID}
      client-secret: ${GOOGLE_OAUTH_CLIENT_SECRET}

# ── AI Provider (§12 B-18, B-24) ─────────────────────────────
# Provider 활성/비활성은 설정으로 전환한다 (R3.1). 키는 절대 기본값을 두지 않는다.
#
# ★ `provider`(단수)와 `providers`(복수)는 다른 것이다.
#     provider  — 어느 어댑터를 붙이든 같아야 하는 공통 값. 시간 제한이 여기다
#     providers — 어댑터별 키·엔드포인트
#   한 글자 차이라 오타가 조용히 무시된다. B-18 에서 확인한 결과 두 이름은 다른 것을
#   가리키므로 합치지 않는다 — 공통 값과 어댑터별 값이며, 합치면 어댑터 하나가 시간
#   제한을 자기 것으로 덮어쓸 수 있게 된다 (#25 의 후속).
ai:
  provider:
    # R6.4 · §6.3 · §11 이 못박은 계약값이다. 배포마다 정하는 값이 아니므로
    # 빠져도 부팅을 막지 않는다 — ProviderProperties 가 같은 값을 알고 있다.
    # 테스트는 @DynamicPropertySource 로 짧은 값을 주입해 25초를 기다리지 않는다 (#25).
    timeout-ms: 25000

    # R3.1 — 어느 어댑터가 실제로 불릴지. 코드 배포 없이 이 값만 바꿔 전환한다 (B-18).
    # 비워 두면 등록된 어댑터가 정확히 하나일 때만 뜬다. 둘 이상이면 부팅이 멈춘다 —
    # 모호한 상태에서 서버가 임의로 하나를 고르지 않는다. Provider 선택은 관리자 전용이다 (I-14).
    #
    # 아직 주석이다. 실 어댑터는 B-22 · B-23 에서 붙고, 그전까지 등록되는 것은 dev 전용
    # 결정론 Provider 하나뿐이라 지목할 것이 없다. 없는 id 를 적으면 부팅이 멈춘다.
    # active: anthropic

  # 어댑터별 접속 정보 (B-22, B-23).
  providers:
    anthropic:
      api-key: ${ANTHROPIC_API_KEY}
    openai:
      api-key: ${OPENAI_API_KEY}
    ollama:
      base-url: ${OLLAMA_BASE_URL}

# ── 관리자 (§7.5 S-4) ────────────────────────────────────────
admin:
  allowed-cidr: ${ADMIN_ALLOWED_CIDR}

# ── 관측성 (§12 B-48) ────────────────────────────────────────
management:
  endpoints:
    web:
      exposure:
        include: health,info,prometheus
  endpoint:
    health:
      probes:
        enabled: true

# ── 로깅 (§2.1, §9.4) ────────────────────────────────────────
# 별도 JSON 인코더 의존성을 추가하지 않는다. 프롬프트·응답 원문 금지 (S-3).
logging:
  structured:
    format:
      console: ecs
