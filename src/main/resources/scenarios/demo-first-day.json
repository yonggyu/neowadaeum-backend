        {
          "type": "DIALOGUE",
          "speakerName": "유나",
          "text": "거기 서 있으면 문 못 열어."
        },
        {
          "type": "NARRATION",
          "speakerName": null,
          "text": "목소리가 뒤에서 왔다. 돌아보기 전에 발소리가 먼저 지나갔다."
        }
      ],
      "choices": [
        {
          "order": 1,
          "text": "가까이 다가간다"
